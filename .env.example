# Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model fallback chain. A comma-separated list of Gemini models to try in order.
# If a model fails with 503/504/429 or a connection error after 3 attempts, the
# next model in the list is used automatically. First model that answers wins.
# GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-2.5-pro

# Backward-compatible single model. Used only if GEMINI_MODELS is not set.
GEMINI_MODEL=gemini-3.8-flash

# Optional: how many text chunks to send per LLM batch during ledger extraction.
# Lower = safer for token limits, higher = fewer API calls. Default 12.
SCD_CHUNK_BATCH_SIZE=12

# Optional: characters per chunk when splitting PDF pages during ingest. Default 3000.
SCD_CHUNK_CHARS=3000

# Optional: pre-select KPI-likely chunks (MD&A, segment information, financial
# highlights, shareholder letter, trade-receivables/revenue notes) before
# calling the LLM; skip pure boilerplate (cover, contents, directors' report
# formalities, long legal sections). All pages stay in the page index, so
# citations always carry a real page number. Default true.
SCD_LEDGER_RELEVANCE_FILTER=true

# Optional: LLM provider. "gemini" (default) or "mock" (offline testing, no API key needed).
SCD_LLM_PROVIDER=gemini

# Optional: LLM operating mode. "online" (default) or "offline".
# offline = use the demo scripted LLM: no internet, no API key, full pipeline testable.
LLM_MODE=online

# Optional: per-request network timeout in seconds for Gemini calls. Default 120
# (floor 30). Backoff + model fallback still apply, so a slow 504 has room to
# complete before the next model in the chain is tried.
SCD_LLM_TIMEOUT_SECONDS=120

# Optional: proxy for Gemini calls. Uncomment and set if your network blocks
# direct access to generativelanguage.googleapis.com (this is the usual cause
# of "read ECONNRESET" errors on corporate/campus networks).
#HTTPS_PROXY=http://user:pass@proxy-host:port
#HTTP_PROXY=http://user:pass@proxy-host:port
